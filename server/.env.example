NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:8080
HOST=127.0.0.1
PORT=8080
# Choose one storage mode. Never set DB_PATH and DATABASE_URL together.
# SQLite: a durable absolute path outside the frontend; single-instance service.
DB_PATH=/absolute/path/to/riftwell.sqlite
# PostgreSQL: remove DB_PATH, use the provider's secret URL with TLS in production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_SIZE=3
# Combined frontend/API defaults. Firebase + Deno uses API_ONLY=true and bearer.
API_ONLY=false
SESSION_TRANSPORT=cookie
# Stable random secret of at least 32 bytes; never a wallet key or frontend setting.
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
HYPEREVM_RPC_URL=https://hyperliquid.drpc.org
CHAIN_CONFIRMATIONS=2
CHAIN_MAX_HEAD_AGE_SECONDS=60
CHAIN_TIMEOUT_MS=8000
# Only configure known reverse proxy IPs/CIDRs. Leave unset when directly connected.
# TRUST_PROXY=10.89.0.2
